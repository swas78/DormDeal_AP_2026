PORT=5001
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/dormdeal
JWT_SECRET=dormdeal_campus_jwt_secret_key_2026
JWT_EXPIRE=30d
CLIENT_URL=http://localhost:5173

# ========================================================
# REAL EMAIL OTP CONFIGURATION (SMTP / Nodemailer)
# ========================================================
# Provider: Gmail / Outlook / Custom University SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-google-app-password
EMAIL_FROM_NAME="DormDeal Verification"

# ========================================================
# REAL SMS OTP CONFIGURATION (Fast2SMS or Twilio)
# ========================================================
# Option 1: Fast2SMS (Instant SMS to Indian mobile numbers)
FAST2SMS_API_KEY=your_fast2sms_api_key

# Option 2: Twilio
# TWILIO_ACCOUNT_SID=your_twilio_account_sid
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_PHONE_NUMBER=+1234567890
